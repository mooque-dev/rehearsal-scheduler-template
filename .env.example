# Postgres connection string (Neon, Supabase, or any Postgres). Required.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Password for /admin, where you edit teams, members, dates and notices.
# It also allows reverting entries in the Update Log. If unset, /admin is off.
ADMIN_PASSWORD=choose-a-long-admin-password

# Passphrase for the read-only /archive page (previous seasons).
ARCHIVE_PIN=choose-a-long-passphrase-only-you-know

# Optional. Set to 1 on a public demo: the admin password is shown on the
# sign-in screen and a "Reset demo" button appears on /admin.
# DEMO_MODE=1
