# Postgres connection string (Neon, Supabase, or any Postgres). Required.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Passphrase for the owner-only /archive page (previous seasons). Choose a long one.
ARCHIVE_PIN=choose-a-long-passphrase-only-you-know

# Password required to revert an entry in the Update Log. If unset, reverting is disabled.
REVERT_PASSWORD=choose-an-admin-password-for-reverting-log-entries
